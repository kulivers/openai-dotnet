<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>The official .NET library for the OpenAI service API.</Description>
    <AssemblyTitle>OpenAI Responses client library for .NET</AssemblyTitle>
    <DefineConstants>$(DefineConstants);OPENAI_RESPONSES</DefineConstants>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="System.ClientModel" />
    <PackageReference Include="System.Net.ServerSentEvents" />
  </ItemGroup>

  <ItemGroup Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <PackageReference Include="System.Diagnostics.DiagnosticSource" />
  </ItemGroup>

  <!-- Build-only dependencies -->
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\OpenAI\src\Utility\*.cs" Link="Shared\Utility\%(Filename)%(Extension)" />
    <!-- NOTE: Do NOT include OpenAI/src/Utility/CodeGen/*.cs via cross-project link.
         The TypeSpec generator's custom-code Roslyn compilation only scans this
         project's directory tree to resolve attributes such as
         [CodeGenVisibility]. Files linked from another project are invisible to
         that scan, which causes the attribute to be silently ignored. Keep a
         copy of CodeGenVisibilityAttribute.cs under this project at
         src/Utility/CodeGen/ instead. -->
    <Compile Include="..\..\OpenAI\src\Generated\Internal\*.cs" Link="Shared\Generated\Internal\%(Filename)%(Extension)" />
    <!-- Exclude locally generated CodeGen attributes that duplicate the ones included from OpenAI above (same namespace) -->
    <Compile Remove="Generated\Internal\CodeGenMemberAttribute.cs" />
    <Compile Remove="Generated\Internal\CodeGenSerializationAttribute.cs" />
    <Compile Remove="Generated\Internal\CodeGenSuppressAttribute.cs" />
    <Compile Remove="Generated\Internal\CodeGenTypeAttribute.cs" />
    <!-- Exclude OpenAI's ClientPipelineExtensions; Responses has its own custom version with matching ProcessMessage extensions -->
    <Compile Remove="..\..\OpenAI\src\Generated\Internal\ClientPipelineExtensions.cs" />
    <Compile Include="..\..\OpenAI\src\Utility\Polyfill\*.cs" Link="Shared\Utility\Polyfill\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
